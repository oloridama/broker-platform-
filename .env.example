# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://broker:broker123@localhost:5432/broker_db

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
# Global API limiter (per IP). Generous enough for a real user with a couple of tabs
# while still blocking scripted abuse. The /api/auth limiter stays strict (10/15min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# ─── Client ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
VITE_APP_NAME=FXA Trade
