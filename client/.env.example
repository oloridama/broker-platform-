# ─── Client ───────────────────────────────────────────────
# In production, leave these EMPTY/unset so the client uses relative
# same-origin URLs (/api and /ws) — the server or reverse proxy serves
# both the frontend and API on the same domain.
#
# For local dev with Vite, point these at the backend:
# VITE_API_BASE_URL=http://localhost:4000/api
# VITE_WS_URL=ws://localhost:4000/ws

VITE_APP_NAME=FXA Trade
